# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Strong multimodal model for vision/image analysis
GEMINI_MODEL=gemini-2.5-flash
# Cheaper, faster text-only model for Q&A nodes (history, knowledge)
GEMINI_MODEL_FAST=gemini-2.0-flash
TAVILY_API_KEY=your_tavily_api_key_here

# Database
DATABASE_URL=sqlite:///./veonix.db

# App
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000"]

# Langfuse Tracing
# Generate public/secret keys from your self-hosted Langfuse instance's project settings after first login (http://localhost:3001).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
OTEL_SERVICE_NAME=veonix-backend

